APP_NAME=EduPredict
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8017
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local PostgreSQL 17 from docker-compose.postgres.yml. The password matches the
# local MariaDB compose file. Do not use it for Supabase or a defense database.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=edupredict
DB_USERNAME=edupredict
DB_PASSWORD=secret
DB_SSLMODE=prefer
DB_EMULATE_PREPARES=false
DB_SCHEMA=public
PGSQL_CHARSET=utf8

# Used by edupredict:copy-mysql-to-pgsql while the app itself uses PostgreSQL.
# Point these at the isolated rehearsal MariaDB, not at a populated shared server,
# unless that server is being read on purpose. The copy command sets the source
# session to read-only.
MYSQL_HOST=mariadb
MYSQL_PORT=3306
MYSQL_DATABASE=edupredict
MYSQL_USERNAME=edupredict
MYSQL_PASSWORD=secret

PGSQL_DEVELOPMENT_DATABASE=edupredict
PGSQL_TESTING_DATABASE=edupredict_testing
PGSQL_DEFENSE_DATABASE=edupredict_defense

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=
AI_VISION_MODEL=
AI_FALLBACK_MODELS=
AI_DAILY_LIMIT=40
AI_TIMEOUT=30
PREDICTOR_DRIVER=heuristic
