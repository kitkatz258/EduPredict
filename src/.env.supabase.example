# Supabase-ready settings. Copy the values you need into an untracked env file.
# Do not put a real password, project ref, or database URL in git.
# Do not point the development app at the future defense Supabase project.

# Direct connection or session pooler (port 5432): migrations, the MariaDB copy,
# and sequence repair. Prepared statements work, so leave emulation off.
# DB_CONNECTION=pgsql
# DB_HOST=db.<project-ref>.supabase.co
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_SSLMODE=require
# DB_EMULATE_PREPARES=false
# DB_SCHEMA=public
# PGSQL_CHARSET=utf8

# Transaction pooler (port 6543) for the running app after migrations.
# Server-side prepared statements do not work in this mode.
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=6543
# DB_USERNAME=postgres.<project-ref>
# DB_EMULATE_PREPARES=true
# DB_SSLMODE=require

# Optional single URL. Prefer the discrete variables above. If you use a URL,
# include sslmode=require and do not also commit the URL.
# DB_URL=

# CA file path, only when sslmode is verify-full. The file itself stays outside git.
# DB_SSLROOTCERT=

# Keep these names distinct. The copy and rollback commands write only to the
# development name. PHPUnit is allowed to refresh only the testing name.
# PGSQL_DEVELOPMENT_DATABASE=postgres
# PGSQL_TESTING_DATABASE=edupredict_testing
# PGSQL_DEFENSE_DATABASE=edupredict_defense

# Store the defense project's host, user, and password in an untracked .env.defense.
# The development role must not own that database.
